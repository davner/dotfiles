{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/session-name.sh --hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/comment-audit.sh\" ] || \"$HOME/.claude/comment-audit.sh\"",
            "timeout": 5,
            "statusMessage": "Auditing comments"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/guard-bash.sh\" ] || \"$HOME/.claude/guard-bash.sh\"",
            "timeout": 5,
            "statusMessage": "Checking command"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true
}
